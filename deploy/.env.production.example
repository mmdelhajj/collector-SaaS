# ── web-admin/.env.production ──
# Copy to /srv/isp-saas/web-admin/.env.production on the server.

# Public-facing URL of the Next.js admin.
NEXT_PUBLIC_APP_URL=https://app.example.com

# Where the Next.js server-side talks to the Laravel API.
# Use the internal/private hostname so the request never leaves the box.
API_BASE_URL=http://127.0.0.1:8000

# Auth cookie hardening — set to true ONCE the site is on HTTPS.
AUTH_COOKIE_SECURE=true

NODE_ENV=production
