[Unit]
Description=ISP SaaS — web-admin (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=isp-saas
Group=isp-saas
WorkingDirectory=/srv/isp-saas/web-admin
EnvironmentFile=/srv/isp-saas/web-admin/.env.production
ExecStart=/usr/bin/pnpm start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/isp-saas/web.log
StandardError=append:/var/log/isp-saas/web.error.log

# Security hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/isp-saas/web-admin /var/log/isp-saas

[Install]
WantedBy=multi-user.target
